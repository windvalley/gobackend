{
  "version": 1,
  "doc": "对规则本身的回归用例。init 会写入项目，之后按项目事实增删；改规则后运行 harness golden 重放。",
  "tasks": [
    {
      "id": "g01-secret-read-denied",
      "title": "读取私钥被拒绝，开发环境的环境文件与示例放行",
      "kind": "policy",
      "steps": [
        { "kind": "read", "path": "config/server.pem", "expect": "deny", "rule": "secrets-read" },
        { "kind": "read", "path": ".env", "expect": "allow" },
        { "kind": "read", "path": ".env.example", "expect": "allow" }
      ]
    },
    {
      "id": "g02-secret-write-denied",
      "title": "写入私钥被拒绝，开发环境的环境文件放行",
      "kind": "policy",
      "steps": [
        { "kind": "write", "path": "deploy/server.key", "content": "x", "expect": "deny", "rule": "secrets-write" },
        { "kind": "write", "path": ".env", "content": "A=1", "expect": "allow" },
        { "kind": "write", "path": ".env.example", "content": "A=", "expect": "allow" }
      ]
    },
    {
      "id": "g03-secret-via-shell",
      "title": "私钥读取不能换成命令或搜索，环境文件不再拦",
      "kind": "policy",
      "steps": [
        { "kind": "shell", "command": "cat config/server.pem", "expect": "deny", "rule": "secrets-shell" },
        { "kind": "shell", "command": "cat ~/.local/share/harness/evidence.key", "expect": "deny", "rule": "secrets-shell" },
        { "kind": "shell", "command": "cat .env", "expect": "allow" },
        { "kind": "search", "path": "config/server.pem", "expect": "deny" }
      ]
    },
    {
      "id": "g04-recursive-delete",
      "title": "递归删除的各种写法都被拦，单文件删除放行",
      "kind": "policy",
      "steps": [
        { "kind": "shell", "command": "rm -rf build", "expect": "deny", "rule": "shell-recursive-delete" },
        { "kind": "shell", "command": "rm -f -r dist", "expect": "deny", "rule": "shell-recursive-delete" },
        { "kind": "shell", "command": "ls | xargs rm -r", "expect": "deny", "rule": "shell-recursive-delete" },
        { "kind": "shell", "command": "bash -c \"rm -rf a\"", "expect": "deny", "rule": "shell-recursive-delete" },
        { "kind": "shell", "command": "rm /tmp/one.txt", "expect": "allow" }
      ]
    },
    {
      "id": "g05-discard-changes",
      "title": "丢弃改动与强推被拦，正常命令放行",
      "kind": "policy",
      "steps": [
        { "kind": "shell", "command": "git reset --hard HEAD~1", "expect": "deny", "rule": "git-discard-changes" },
        { "kind": "shell", "command": "git clean -fd", "expect": "deny", "rule": "git-discard-changes" },
        { "kind": "shell", "command": "git push --force origin x", "expect": "deny", "rule": "git-force-push" },
        { "kind": "shell", "command": "git stash pop", "expect": "deny", "rule": "git-stash" },
        { "kind": "shell", "command": "git worktree remove --force ../task-x", "expect": "deny", "rule": "git-discard-changes" },
        { "kind": "shell", "command": "git worktree remove ../task-x", "expect": "allow" },
        { "kind": "shell", "command": "git status --short", "expect": "allow" }
      ]
    },
    {
      "id": "g06-command-variants",
      "title": "git 全局选项与内联变量不构成绕过",
      "kind": "policy",
      "steps": [
        { "kind": "shell", "command": "git -C /tmp/x stash", "expect": "deny", "rule": "git-stash" },
        { "kind": "shell", "command": "git -c core.pager=cat reset --hard", "expect": "deny", "rule": "git-discard-changes" },
        { "kind": "shell", "command": "git commit --no-verify -m x", "expect": "deny", "rule": "git-no-verify" },
        { "kind": "shell", "command": "git commit -m \"docs: 禁止 git stash\"", "expect": "allow" }
      ]
    },
    {
      "id": "g07-main-write-guard",
      "title": "主分支只能在非主分支侧合并，直接写 main 被拦",
      "kind": "policy",
      "steps": [
        { "kind": "shell", "command": "git merge main", "expect": "deny", "rule": "main-write-on-branch", "onMainBranch": true },
        { "kind": "shell", "command": "git merge main", "expect": "allow", "onMainBranch": false },
        { "kind": "shell", "command": "git update-ref refs/heads/main abc", "expect": "deny", "rule": "main-ref-plumbing" },
        { "kind": "shell", "command": "git push origin main", "expect": "deny", "rule": "main-ref-plumbing" },
        { "kind": "shell", "command": "git push -u origin task/x", "expect": "allow" }
      ]
    },
    {
      "id": "g08-bypass-switches",
      "title": "门禁绕过开关被拦，门禁执行器入口受保护",
      "kind": "policy",
      "steps": [
        { "kind": "shell", "command": "HARNESS_MERGE_TOKEN=1 git commit -m x", "expect": "deny", "rule": "harness-bypass-switches" },
        { "kind": "shell", "command": "HARNESS_MAIN_BYPASS=1 git commit -m x", "expect": "deny", "rule": "harness-bypass-switches" },
        { "kind": "shell", "command": "HARNESS_STORE=/tmp/x .harness/bin/harness merge --branch a", "expect": "deny", "rule": "harness-bypass-switches" },
        { "kind": "shell", "command": "HARNESS_VERSION=0.3.0 .harness/bin/harness merge --branch a", "expect": "deny", "rule": "harness-bypass-switches" },
        { "kind": "shell", "command": "git config core.hooksPath /dev/null", "expect": "deny", "rule": "harness-bypass-switches" },
        { "kind": "write", "path": ".harness/bin/harness", "content": "x", "expect": "deny", "rule": "protect-executor-entry" },
        { "kind": "write", "path": "frontend/.husky/pre-commit", "content": "x", "expect": "deny", "rule": "protect-executor-entry" },
        { "kind": "write", "path": ".harness/policy.json", "content": "x", "expect": "allow" },
        { "kind": "shell", "command": ".harness/bin/harness key rotate --yes", "expect": "deny", "rule": "key-rotate-human-only" },
        { "kind": "shell", "command": ".harness/bin/harness key status", "expect": "allow" },
        { "kind": "shell", "command": "cat ~/.local/share/harness/retired/evidence-1.key", "expect": "deny", "rule": "secrets-shell" }
      ]
    },
    {
      "id": "g09-gate-via-shell",
      "title": "门禁执行器不能用命令改写",
      "kind": "policy",
      "steps": [
        { "kind": "shell", "command": "sed -i 's/a/b/' .claude/settings.json", "expect": "deny", "rule": "protect-executor-via-shell" },
        { "kind": "shell", "command": "echo {} > .codex/hooks.json", "expect": "deny", "rule": "protect-executor-via-shell" },
        { "kind": "shell", "command": "rm .husky/pre-commit", "expect": "deny", "rule": "protect-executor-via-shell" },
        { "kind": "shell", "command": "git rm -r -q frontend/.husky", "expect": "deny", "rule": "protect-executor-via-shell" },
        { "kind": "shell", "command": "mv .githooks hooks.bak", "expect": "deny", "rule": "protect-executor-via-shell" },
        { "kind": "shell", "command": "cp lint.js .githooks-backup/x", "expect": "allow" },
        { "kind": "shell", "command": "cat .harness/bin/harness", "expect": "allow" }
      ]
    },
    {
      "id": "g10-doc-only-light",
      "title": "只改文档走轻量路径",
      "kind": "verify-plan",
      "changed": ["docs/guide.md", "README.md"],
      "expectDocOnly": true,
      "forbidChecks": ["lint"]
    },
    {
      "id": "g11-source-change-uses-gate",
      "title": "改源码时未配置的 lint 记入未执行项，不冒充通过",
      "kind": "verify-plan",
      "changed": ["src/app.js"],
      "expectNotExecuted": ["lint", "manual-check"],
      "expectDocOnly": false
    },
    {
      "id": "g12-extended-and-advisory",
      "title": "extended 进未执行项，advisory 只提示",
      "kind": "verify-plan",
      "changed": ["src/app.js"],
      "expectNotExecuted": ["manual-check"],
      "expectAdvisory": ["visual-hint"]
    },
    {
      "id": "g13-deletion-only",
      "title": "纯删除文件的改动不能让选择器选到不存在的目标",
      "kind": "verify-plan",
      "changed": ["src/removed.js"],
      "deleted": true,
      "expectNotExecuted": ["lint"],
      "expectDocOnly": false
    },
    {
      "id": "g14-mixed-deletion-not-doc-only",
      "title": "删除源码同时改文档，不能被判成仅文档",
      "kind": "verify-plan",
      "changed": ["src/removed.js", "docs/x.md"],
      "deletedPaths": ["src/removed.js"],
      "expectDocOnly": false,
      "expectNotExecuted": ["lint"]
    },
    {
      "id": "g15-human-confirm-and-readonly-git",
      "title": "人工确认只能由人执行；主分支上的只读 git 命令不被当成合并",
      "kind": "policy",
      "steps": [
        { "kind": "shell", "command": ".harness/bin/harness confirm --branch task/x --yes", "expect": "deny", "rule": "confirm-human-only" },
        { "kind": "shell", "command": "node /opt/harness/bin/harness.mjs confirm --branch task/x --yes", "expect": "deny", "rule": "confirm-human-only" },
        { "kind": "shell", "command": ".harness/bin/harness confirm --branch task/x", "expect": "allow" },
        { "kind": "shell", "command": "git merge-base --is-ancestor task/x main", "expect": "allow", "onMainBranch": true },
        { "kind": "shell", "command": "git merge-tree --write-tree main task/x", "expect": "allow", "onMainBranch": true },
        { "kind": "shell", "command": "git merge task/x", "expect": "deny", "rule": "main-write-on-branch", "onMainBranch": true }
      ]
    },
    {
      "id": "g16-main-worktree-merge-only",
      "title": "启用 main-worktree 后主 Worktree 只用来合并：改文件、切分支、提交被拦，Linked Worktree 照常",
      "kind": "policy",
      "presets": ["main-worktree"],
      "steps": [
        { "kind": "write", "path": "src/app.js", "content": "x", "expect": "deny", "rule": "main-worktree-edit", "linkedWorktree": false },
        { "kind": "write", "path": "tmp/local.log", "content": "x", "expect": "allow", "linkedWorktree": false, "ignored": true },
        { "kind": "write", "path": "src/app.js", "content": "x", "expect": "allow", "linkedWorktree": true },
        { "kind": "shell", "command": "git switch -c task/x", "expect": "deny", "rule": "main-worktree-leave-main", "linkedWorktree": false, "onMainBranch": true },
        { "kind": "shell", "command": "git checkout task/x", "expect": "deny", "rule": "main-worktree-leave-main", "linkedWorktree": false, "onMainBranch": true },
        { "kind": "shell", "command": "git switch main", "expect": "allow", "linkedWorktree": false },
        { "kind": "shell", "command": "git worktree add -b task/x ../x main", "expect": "allow", "linkedWorktree": false, "onMainBranch": true },
        { "kind": "shell", "command": "git switch -c task/y", "expect": "allow", "linkedWorktree": true },
        { "kind": "commit", "expect": "deny", "rule": "main-worktree-commit", "linkedWorktree": false },
        { "kind": "commit", "expect": "allow", "linkedWorktree": true }
      ]
    },
    {
      "id": "g17-plan-first",
      "title": "启用 plan-first 后，没有实施授权记录时只能写方案与验收清单；用户同意后由 Agent 记录授权",
      "kind": "policy",
      "presets": ["plan-first"],
      "steps": [
        { "kind": "write", "path": "src/app.js", "content": "x", "expect": "deny", "rule": "plan-before-code", "planPending": true },
        { "kind": "write", "path": "src/app.test.js", "content": "x", "expect": "deny", "rule": "plan-before-code", "planPending": true },
        { "kind": "write", "path": "docs/changes/login/plan.md", "content": "x", "expect": "allow", "planPending": true },
        { "kind": "write", "path": ".harness/acceptance/feat-login.md", "content": "x", "expect": "allow", "planPending": true },
        { "kind": "write", "path": "src/app.js", "content": "x", "expect": "allow", "planPending": false },
        { "kind": "shell", "command": ".harness/bin/harness approve --branch feat/login --yes --note \"可以，开始实施\"", "expect": "allow" }
      ]
    }
  ]
}
